{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-starter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Hard stops for a stuck loop or a runaway request. Size these to the app.
  "limits": { "cpu_ms": 1000, "subrequests": 50 },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  },
  "vars": {
    // Comma-separated origins allowed to call the API. Add the production origin here.
    "ALLOWED_ORIGINS": "http://localhost:5293"
  },
  // Each project needs its own ports, so they can run side by side.
  "dev": { "port": 8817, "inspector_port": 9259 }
}
